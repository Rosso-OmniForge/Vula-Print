# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for Vula! Print on Windows.

Onedir mode. Produces dist/VulaPrint/ containing VulaPrint.exe and
its _internal/ runtime. Inno Setup (vula_print.iss) wraps that tree
into a single installer exe.

Build from the repo root:
    pyinstaller --clean --noconfirm windows/vula_print.spec
"""
from PyInstaller.utils.hooks import collect_submodules


# win32com.client is imported lazily inside vula_platform.enable_windows_autostart,
# so PyInstaller's static analysis will not find it. These are the modules
# that would otherwise be missing at runtime on a fresh install.
hiddenimports = [
    "win32print",             # Phase B — spooler submission
    "win32crypt",             # Phase D — DPAPI at-rest encryption
    "win32com",               # Phase G — autostart shortcut
    "win32com.client",        # Phase G — WScript.Shell dispatch
    "pythoncom",              # Phase G — COM initialisation
    "pywintypes",             # Phase G — COM exception base
    "serial.tools.list_ports",
    "serial.tools.list_ports_windows",
]
# Pull in every win32com submodule — some are loaded reflectively by
# pywin32's own dispatch mechanism and are impossible to enumerate.
hiddenimports += collect_submodules("win32com")


a = Analysis(
    ["../vula_print_app.py"],
    pathex=[".."],
    binaries=[],
    datas=[
        # VERSION is read by vula_config._read_app_version() via
        # Path(__file__).parent / "VERSION". Inside the bundle __file__
        # points into sys._MEIPASS, so VERSION must be there too.
        ("../VERSION", "."),
        # assets/Vula_Logo.png is used by vula_config.brand_logo_path
        # and by vula_ui/tray.py's icon fallback.
        ("../assets", "assets"),
    ],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        # Heavy libraries that aren't used at runtime and bloat the
        # bundle. PIL is used — do not exclude.
        "tkinter", "matplotlib", "numpy", "scipy", "pandas",
        "pytest", "setuptools", "pip",
    ],
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="VulaPrint",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,          # no console window — pure GUI app
    disable_windowed_traceback=False,
    icon="VulaPrint.ico",    # generated by build.ps1 from assets/Vula_Logo.png
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="VulaPrint",
)