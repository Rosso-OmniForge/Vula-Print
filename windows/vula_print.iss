; Vula! Print — Inno Setup script.
; Build with:  iscc /DAppVersion=1.1.902 windows\vula_print.iss
;
; Produces:  windows\Output\VulaPrint-<version>-Setup.exe
;
; Silent install (IT deployment):
;     VulaPrint-1.1.902-Setup.exe /SILENT /NoLogUpload
;
; Deliberately NOT signed. SmartScreen will warn on first install —
; see windows/README.md "Installing on Windows".

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif

[Setup]
AppId={{B8E5C1D6-4F2A-4B3A-9E1D-3F7A8C2E1D95}
AppName=Vula Print
AppVersion={#AppVersion}
AppVerName=Vula Print {#AppVersion}
AppPublisher=OmniForge Research
DefaultDirName={autopf}\Vula Print
DefaultGroupName=Vula Print
DisableProgramGroupPage=yes
; Don't prompt for admin — the user asked for a double-click install.
; The default is admin (needed for Program Files and common StartUp),
; but PrivilegesRequired=lowest would install per-user. Stick with
; admin so autostart works for all users on the box.
PrivilegesRequired=admin
OutputDir=Output
OutputBaseFilename=VulaPrint-{#AppVersion}-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; SetupIconFile needs the .ico — generated by build.ps1.
SetupIconFile=VulaPrint.ico
; Uninstall removes {commonappdata}\Vula via [UninstallDelete] below.
UninstallDisplayIcon={app}\VulaPrint.exe
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; Copy the whole PyInstaller onedir tree.
Source: "..\dist\VulaPrint\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Dirs]
; The log-upload-disabled flag and (future) update-url.txt live here.
; Full control for Administrators + SYSTEM, read for Users. This is
; the Windows equivalent of /etc/vula (0751 root:root on Linux).
Name: "{commonappdata}\Vula"; Permissions: admins-full system-full users-read

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional icons:"

[Icons]
; Start Menu — launchable from the classic menu.
Name: "{group}\Vula Print"; Filename: "{app}\VulaPrint.exe"
Name: "{group}\Uninstall Vula Print"; Filename: "{uninstallexe}"
; Desktop — user can uncheck on the Tasks page of the installer.
Name: "{commondesktop}\Vula Print"; Filename: "{app}\VulaPrint.exe"; Tasks: desktopicon
; Autostart — machine-wide. This is the Windows equivalent of the
; systemd user service that autostarts VulaPrint on Linux.
; The lnk is removed by the uninstaller automatically (Inno Setup
; tracks {commonstartup} shortcuts created via [Icons]).
Name: "{commonstartup}\Vula Print"; Filename: "{app}\VulaPrint.exe"

[Run]
; Optional: launch the app immediately after install. User can uncheck.
Filename: "{app}\VulaPrint.exe"; Description: "Launch Vula Print"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Remove the machine-scoped Vula directory. Without this, a stray
; log-upload-disabled or update-url.txt would survive an uninstall
; and could silently re-apply on a later reinstall.
Type: filesandordirs; Name: "{commonappdata}\Vula"

[Code]
procedure CreateLogUploadDisabledFlag();
var
  LogDir: string;
  LogFilePath: string;
  Content: string;
begin
  if ExpandConstant('{param:NoLogUpload|0}') <> '1' then
    exit;
  LogDir := ExpandConstant('{commonappdata}\Vula');
  ForceDirectories(LogDir);
  LogFilePath := LogDir + '\log-upload-disabled';
  if not FileExists(LogFilePath) then
  begin
    Content := 'Present => Vula Print refuses to upload logs to any backend.' + NewLine
             + 'Created by the installer with /NoLogUpload.' + NewLine
             + 'Remove with Administrator privileges to re-enable.' + NewLine;
    SaveStringToFile(LogFilePath, Content, False);
  end;
end;

procedure WriteUpdateUrl();
var
  UpdateUrl: string;
  LogDir: string;
  UrlFile: string;
  Content: string;
begin
  UpdateUrl := ExpandConstant('{param:UpdateURL|}');
  if UpdateUrl = '' then
    exit;
  LogDir := ExpandConstant('{commonappdata}\Vula');
  ForceDirectories(LogDir);
  UrlFile := LogDir + '\update-url.txt';
  Content := UpdateUrl + NewLine;
  SaveStringToFile(UrlFile, Content, False);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    CreateLogUploadDisabledFlag();
    WriteUpdateUrl();
  end;
end;

function InitializeUninstall(): Boolean;
var
  Reply: Integer;
begin
  Result := True;
  Reply := MsgBox('Also remove this user''s Vula Print settings and print history?' + NewLine + NewLine + 'Choose No to keep them (recommended when reinstalling).', mbConfirmation, MB_YESNO or MB_DEFBUTTON2);
  if Reply = IDYES then
  begin
    DelTree(ExpandConstant('{userappdata}\VulaPrint'), True, True, True);
  end;
end;